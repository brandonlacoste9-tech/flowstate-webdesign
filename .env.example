# Inbox that receives form submissions
CONTACT_TO_EMAIL=brandonlacoste9@gmail.com

# Resend will not deliver to Gmail from onboarding@resend.dev.
# After a real domain is on the site (not *.netlify.app):
# 1. Add that domain in Resend
# 2. Set SPF / DKIM / DMARC on the DNS
# 3. CONTACT_FROM_EMAIL=Flowstate <hello@yourdomain>
# 4. Put RESEND_API_KEY and CONTACT_TO_EMAIL on Netlify (Production)
RESEND_API_KEY=

# Until a domain is verified, the browser falls back to FormSubmit.
CONTACT_FROM_EMAIL=Flowstate <onboarding@resend.dev>
